  "item": [
    {
      "name": "GET 200 (Cache Miss)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is image/jpeg\", function () {",
              "    pm.response.to.have.header(\"Content-Type\", \"image/jpeg\");",
              "});",
              "",
              "pm.test(\"Image source is valid\", function () {",
              "    pm.expect([\"http.cat\", \"cache\"]).to.include(",
              "        pm.response.headers.get(\"X-Cache-Source\")",
              "    );",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
